LLM_PROVIDER=none
# Local-first (recommended for development — no cloud spend):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# (from host process without Docker: http://127.0.0.1:11434/v1)
# Leave LLM_MODEL_* empty to use each team's TeamAgentSpec default (llama3.2),
# or override per capability:
# LLM_MODEL_DESIGN=llama3.2
# LLM_MODEL_WRITING=llama3.2
# LLM_MODEL_ART=llama3.2
# LLM_MODEL_ENGINEERING=llama3.2
# LLM_MODEL_QA=llama3.2
# LLM_MODEL_PRODUCER=llama3.2

# Paid swap for evals (optional):
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL_DESIGN=gpt-4o-mini

# Generic OpenAI-compatible server (vLLM, LM Studio, etc.):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=local

# Agent runtime: auto|pydantic_ai|deterministic (design also: reflective|langgraph)
DESIGN_AGENT_MODE=auto
STORY_AGENT_MODE=auto
ART_AGENT_MODE=auto
ENGINEERING_AGENT_MODE=auto
QA_AGENT_MODE=auto
PRODUCER_AGENT_MODE=auto

# Image generation (separate from chat). Local-first:
# IMAGE_PROVIDER=automatic1111
# IMAGE_BASE_URL=http://host.docker.internal:7860
# IMAGE_MODEL=
# IMAGE_SIZE=512x512
# IMAGE_SOFT_FAIL=true
IMAGE_PROVIDER=none

# Browser-reachable API base for Phaser texture URLs
PUBLIC_API_BASE_URL=http://localhost:8080
ASSET_STORAGE_DIR=data/assets

# Engineering dual-runtime experiment (IR compile + Cyborg SDK JS)
# SDK scripts need static lint; LLM security review runs when LLM is configured.
ENGINEERING_SDK_ENABLED=true
ENGINEERING_SDK_LLM_REVIEW=true
ENGINEERING_SDK_LLM_AUTHORSHIP=true
