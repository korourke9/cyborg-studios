LLM_PROVIDER=none
# Cloud example:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL_DESIGN=gpt-4o-mini

# Local / open-source example (Ollama):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL_DESIGN=llama3.2

# Generic OpenAI-compatible server (vLLM, LM Studio, etc.):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=local
# LLM_MODEL_DESIGN=my-local-model

# Agent runtime: auto|pydantic_ai|reflective|langgraph|deterministic
DESIGN_AGENT_MODE=auto
# Story team: auto|pydantic_ai|deterministic
STORY_AGENT_MODE=auto
# Art team: auto|pydantic_ai|deterministic
ART_AGENT_MODE=auto
