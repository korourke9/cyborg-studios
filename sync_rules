#!/usr/bin/env bash
# Sync .cursor/rules and docs between this repo and another location.
# Usage: ./sync_rules from-repo [TARGET]  |  ./sync_rules to-repo [SOURCE]
# Default TARGET/SOURCE: ~/.cursor/cyborg-studios

set -e
REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
DEFAULT="${HOME}/.cursor/cyborg-studios"

usage() {
  echo "Usage: $0 from-repo [TARGET]   # repo -> TARGET"
  echo "       $0 to-repo [SOURCE]     # SOURCE -> repo"
  echo "Default: ${DEFAULT}"
}

sync_dir() {
  local src="$1" dst="$2"
  [[ ! -d "$src" ]] && return
  mkdir -p "$(dirname "$dst")"
  rsync -a --delete "$src/" "$dst/"
  echo "Synced: $src -> $dst"
}

case "${1:-}" in
  from-repo)
    T="${2:-$DEFAULT}"
    sync_dir "$REPO_ROOT/.cursor/rules" "$T/.cursor/rules"
    sync_dir "$REPO_ROOT/docs" "$T/docs"
    ;;
  to-repo)
    S="${2:-$DEFAULT}"
    sync_dir "$S/.cursor/rules" "$REPO_ROOT/.cursor/rules"
    sync_dir "$S/docs" "$REPO_ROOT/docs"
    ;;
  *) usage; exit 1 ;;
esac
